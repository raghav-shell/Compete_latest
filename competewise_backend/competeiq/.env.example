# CompeteIQ environment variables — copy to .env and fill in values

# Default competitors (comma-separated domains)
COMPETITORS=linear.app,notion.so,vercel.com

# LLM & search
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Notion export
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Application
DEBUG=false

# Optional: comma-separated CORS origins (defaults to http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
